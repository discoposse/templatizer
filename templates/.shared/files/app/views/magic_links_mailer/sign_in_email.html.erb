<div style="max-width:600px;margin:0 auto;padding:24px;font-family:Helvetica Neue,Arial,sans-serif;color:#111827;">
  <h1 style="margin:0 0 16px;font-size:22px;">Sign in to __APP_DISPLAY_NAME__</h1>
  <p>Hello <%= @user.first_name %>,</p>
  <p>Use the button below to sign in. This link expires in 5 minutes. Changing your password invalidates it.</p>
  <p style="margin:28px 0;">
    <a href="<%= magic_link_url(@token) %>" style="display:inline-block;background:#4f46e5;color:#ffffff;padding:12px 24px;text-decoration:none;font-weight:600;border-radius:6px;">Sign in</a>
  </p>
  <p style="font-size:13px;color:#4b5563;">Or paste this link into your browser:</p>
  <p style="font-size:12px;color:#6b7280;word-break:break-all;"><%= magic_link_url(@token) %></p>
  <p style="font-size:13px;color:#4b5563;">If you did not request this link, you can ignore this email.</p>
</div>
