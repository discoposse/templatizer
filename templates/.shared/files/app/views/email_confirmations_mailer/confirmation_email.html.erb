<div style="max-width:600px;margin:0 auto;padding:24px;font-family:Helvetica Neue,Arial,sans-serif;color:#111827;">
  <h1 style="margin:0 0 16px;font-size:22px;">Confirm your email</h1>
  <p>Hello <%= @user.first_name %>,</p>
  <p>Confirm your email address to finish setting up __APP_DISPLAY_NAME__. This link expires in 2 days.</p>
  <p style="margin:28px 0;">
    <a href="<%= email_confirmation_url(@token) %>" style="display:inline-block;background:#4f46e5;color:#ffffff;padding:12px 24px;text-decoration:none;font-weight:600;border-radius:6px;">Confirm email</a>
  </p>
  <p style="font-size:13px;color:#4b5563;">Or paste this link into your browser:</p>
  <p style="font-size:12px;color:#6b7280;word-break:break-all;"><%= email_confirmation_url(@token) %></p>
  <p style="font-size:13px;color:#4b5563;">If you did not sign up, you can ignore this email.</p>
</div>
