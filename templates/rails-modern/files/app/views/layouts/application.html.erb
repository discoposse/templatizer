<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || app_display_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= app_display_name %>">
    <meta name="apple-mobile-web-app-title" content="<%= app_display_name %>">
    <meta name="theme-color" content="#4f46e5">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-full flex-col bg-gray-50 text-gray-900">
    <header class="border-b border-gray-200 bg-white">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
        <%= link_to root_path, class: "flex items-center gap-3" do %>
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 text-white shadow">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
          </span>
          <span class="text-lg font-semibold tracking-tight"><%= app_display_name %></span>
        <% end %>

        <nav class="flex flex-wrap items-center gap-2" aria-label="Primary">
          <% if authenticated? %>
            <%= link_to "Home", root_path, class: "rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100" %>
            <%= link_to "Profile", profile_path, class: "rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100" %>
            <%= button_to "Sign out", sign_out_path, method: :delete, form: { class: "inline-flex" }, class: "rounded-md bg-gray-100 px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-200" %>
          <% else %>
            <%= link_to "Sign in", new_session_path, class: "rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100" %>
            <%= link_to "Sign up", new_sign_up_path, class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
          <% end %>
        </nav>
      </div>
    </header>

    <% flash.each do |type, message| %>
      <% next if message.blank? %>
      <% tone = type.to_s == "alert" ? "border-red-400 bg-red-50 text-red-800" : "border-emerald-400 bg-emerald-50 text-emerald-800" %>
      <div class="border-b border-l-4 px-4 py-3 <%= tone %>" role="<%= type.to_s == "alert" ? "alert" : "status" %>">
        <p class="mx-auto max-w-7xl text-sm"><%= sanitize(message.to_s, tags: %w[a], attributes: %w[href class]) %></p>
      </div>
    <% end %>

    <main id="main-content" class="flex-1">
      <%= yield %>
    </main>

    <footer class="mt-auto border-t border-gray-200 bg-white">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-3 px-4 py-6 text-sm text-gray-500">
        <span>© <%= Date.current.year %> <%= app_display_name %></span>
        <% if Rails.env.development? %>
          <span aria-hidden="true">·</span>
          <%= link_to "Letter Opener", "/letter_opener", class: auth_link_class %>
        <% end %>
      </div>
    </footer>
  </body>
</html>
