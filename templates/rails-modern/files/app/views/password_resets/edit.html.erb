<% content_for :title, "Set new password" %>

<div class="flex flex-col justify-center px-4 py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <h1 class="text-center text-3xl font-semibold tracking-tight text-gray-900">Set a new password</h1>
  </div>

  <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
    <div class="bg-white px-6 py-8 shadow-sm ring-1 ring-gray-200 sm:rounded-xl sm:px-10">
      <% if @user&.errors&.any? %>
        <div class="mb-6 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-700" role="alert">
          <ul class="list-disc space-y-1 pl-5">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with url: edit_password_reset_path(token: params[:token]), method: :patch, class: "space-y-6" do |form| %>
        <div>
          <%= form.label :password, "New password", class: auth_label_class %>
          <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", class: auth_input_class %>
          <p class="mt-1 text-xs text-gray-500">At least 8 characters.</p>
        </div>
        <div>
          <%= form.label :password_confirmation, "Confirm new password", class: auth_label_class %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: auth_input_class %>
        </div>
        <%= form.submit "Update password", class: auth_button_class %>
      <% end %>
    </div>
  </div>
</div>
