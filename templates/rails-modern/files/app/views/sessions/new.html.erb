<% content_for :title, "Sign in" %>

<div class="flex flex-col justify-center px-4 py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <h1 class="text-center text-3xl font-semibold tracking-tight text-gray-900">Sign in</h1>
    <p class="mt-2 text-center text-sm text-gray-600">
      or
      <%= link_to "create an account", new_sign_up_path, class: auth_link_class %>
    </p>
  </div>

  <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
    <div class="bg-white px-6 py-8 shadow-sm ring-1 ring-gray-200 sm:rounded-xl sm:px-10">
      <%= form_with url: session_path, class: "space-y-6" do |form| %>
        <div>
          <%= form.label :email_address, "Email address", class: auth_label_class %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", class: auth_input_class %>
        </div>

        <div>
          <div class="flex items-center justify-between gap-3">
            <%= form.label :password, "Password", class: auth_label_class %>
            <%= link_to "Forgot password?", new_password_reset_path, class: "text-xs font-medium text-indigo-600 hover:text-indigo-500" %>
          </div>
          <%= form.password_field :password, required: true, autocomplete: "current-password", class: auth_input_class %>
        </div>

        <%= form.submit "Sign in", class: auth_button_class %>
      <% end %>

      <p class="mt-6 text-center text-sm text-gray-600">
        <%= link_to "Email me a sign-in link", new_magic_link_path, class: auth_link_class %>
        <span class="mx-1" aria-hidden="true">·</span>
        <%= link_to "Resend confirmation", new_email_confirmation_path, class: auth_link_class %>
      </p>
    </div>
  </div>
</div>
