<% content_for :title, "Profile" %>

<div class="carbon-surface min-h-[60vh] border-b border-[#e0e0e0]">
  <div class="mx-auto max-w-3xl px-6 py-12 lg:px-8">
    <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.22em] text-[#525252]">Account</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-[#161616]"><%= @user.full_name %></h1>
    <p class="mt-2 text-sm text-[#525252]"><%= @user.email_address %></p>
    <% if @user.admin? %>
      <p class="mt-2 font-mono text-[10px] font-semibold uppercase tracking-[0.22em] text-[#0f62fe]">Admin</p>
    <% end %>

    <section class="carbon-card mt-10 p-6 sm:p-8">
      <h2 class="text-lg font-semibold text-[#161616]">Your details</h2>
      <%= form_with model: @user, url: profile_path, method: :patch, class: "mt-6 space-y-5" do |form| %>
        <% if @profile_form && @user.errors.any? %>
          <div class="alert alert-error" role="alert">
            <ul class="list-disc pl-5 text-sm">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <%= form.label :first_name, "First name", class: "theme-label" %>
            <%= form.text_field :first_name, required: true, autocomplete: "given-name", class: "theme-input" %>
          </div>
          <div>
            <%= form.label :last_name, "Last name", class: "theme-label" %>
            <%= form.text_field :last_name, required: true, autocomplete: "family-name", class: "theme-input" %>
          </div>
        </div>
        <div>
          <p class="theme-label">Email</p>
          <p class="text-sm text-[#525252]"><%= @user.email_address %></p>
          <p class="mt-1 text-xs text-[#6f6f6f]">
            <% if @user.email_confirmed? %>
              Confirmed <%= @user.email_confirmed_at.to_fs(:long) %>
            <% else %>
              Not confirmed yet.
            <% end %>
          </p>
        </div>
        <%= form.submit "Save profile", class: glyph_button_classes(variant: :secondary) %>
      <% end %>
    </section>

    <section class="carbon-card mt-6 p-6 sm:p-8">
      <h2 class="text-lg font-semibold text-[#161616]">Password</h2>
      <%= form_with url: profile_password_path, method: :patch, scope: :password_change, class: "mt-6 space-y-5" do |form| %>
        <% if @password_form && @user.errors.any? %>
          <div class="alert alert-error" role="alert">
            <ul class="list-disc pl-5 text-sm">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <div>
          <%= form.label :current_password, "Current password", class: "theme-label" %>
          <%= form.password_field :current_password, required: true, autocomplete: "current-password", class: "theme-input" %>
        </div>
        <div>
          <%= form.label :password, "New password", class: "theme-label" %>
          <%= form.password_field :password, required: true, autocomplete: "new-password", class: "theme-input" %>
          <p class="mt-1 text-xs text-[#6f6f6f]">At least 8 characters. Other devices will be signed out.</p>
        </div>
        <div>
          <%= form.label :password_confirmation, "Confirm new password", class: "theme-label" %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "theme-input" %>
        </div>
        <%= form.submit "Update password", class: "#{glyph_button_classes} w-full justify-center sm:w-auto" %>
      <% end %>
    </section>

    <section class="carbon-card mt-6 p-6 sm:p-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-lg font-semibold text-[#161616]">Sessions</h2>
        <% if @sessions.many? %>
          <%= button_to "Sign out other devices", profile_sessions_path, method: :delete, class: glyph_button_classes(variant: :secondary) %>
        <% end %>
      </div>
      <ul class="mt-4 divide-y divide-[#f4f4f4] border-t border-[#e0e0e0]">
        <% @sessions.each do |session_record| %>
          <li class="flex flex-wrap items-center justify-between gap-3 py-4 text-sm">
            <div>
              <p class="font-medium text-[#161616]"><%= session_record.user_agent.to_s.truncate(96).presence || "Unknown device" %></p>
              <p class="mt-1 text-[#525252]">
                <%= session_record.ip_address.presence || "Unknown IP" %>
                · <%= time_ago_in_words(session_record.created_at) %> ago
                <% if session_record.id == Current.session&.id %>
                  · This device
                <% end %>
              </p>
            </div>
            <% if session_record.id == Current.session&.id %>
              <%= button_to "Sign out", sign_out_path, method: :delete, class: glyph_button_classes(variant: :secondary) %>
            <% else %>
              <%= button_to "Revoke", profile_session_path(session_record), method: :delete, class: glyph_button_classes(variant: :ghost) %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  </div>
</div>
